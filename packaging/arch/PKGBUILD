# Maintainer: SysArchX <https://github.com/SysArchX>
pkgname=omnistudio-ai
pkgver=1.1.0
pkgrel=1
pkgdesc="Cross-platform workspace with multi-provider chat, 2D video studio and APK factory"
arch=('x86_64')
url="https://github.com/SysArchX/OmniStudio"
license=('MIT')
depends=('gtk3' 'nss' 'libxss' 'libxtst' 'at-spi2-core' 'libnotify')
makedepends=('nodejs' 'npm')
source=("$pkgname-$pkgver.tar.gz::https://github.com/SysArchX/OmniStudio/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  npm ci
}

build() {
  cd "$pkgname-$pkgver"
  npm run build
  npx electron-builder --linux dir
}

package() {
  cd "$pkgname-$pkgver"
  install -dm755 "$pkgdir/opt/$pkgname"
  cp -r release/linux-unpacked/* "$pkgdir/opt/$pkgname/"

  install -dm755 "$pkgdir/usr/bin"
  ln -s "/opt/$pkgname/$pkgname" "$pkgdir/usr/bin/$pkgname"

  install -dm755 "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/$pkgname.desktop" <<EOF
[Desktop Entry]
Name=OmniStudio AI
Comment=Cross-platform workspace with multi-provider chat, 2D video studio and APK factory
Exec=/opt/$pkgname/$pkgname %U
Terminal=false
Type=Application
Icon=$pkgname
Categories=Development;AudioVideo;Graphics;
EOF

  install -dm755 "$pkgdir/usr/share/icons/hicolor/512x512/apps"
  if [ -f "build/icon.png" ]; then
    install -Dm644 "build/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"
  fi
}